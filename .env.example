# Copy this file to `.env` and fill in your Supabase project values.
# Find these in Supabase dashboard → Settings → API.
# After editing, stop and restart `npm run web` so Expo reloads env vars.
#
# Without these set, the app runs in demo mode (in-memory only).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe — only the publishable key is needed on the client.
# The secret key lives in Supabase Edge Function env (set via
# `supabase secrets set STRIPE_SECRET_KEY=sk_test_...`).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
